# ==============================================================================
# Backend Environment Configuration Template (Personal Academic AI Agent)
# COPY THIS FILE TO .env AND FILL IN YOUR PROJECT SPECIFIC SECRETS
# NEVER COMMIT .env TO VERSION CONTROL
# ==============================================================================

PORT=3000

# Supabase Credentials
# Supabase 2026 Standard: SUPABASE_SECRET_KEY for trusted server-side execution (bypasses RLS)
# Legacy fallback: SUPABASE_ANON_KEY
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# n8n Orchestrator Webhook Endpoints
N8N_WEBHOOK_URL=https://your-n8n-instance.cloud/webhook/academic-chat
N8N_INGESTION_WEBHOOK_URL=https://your-n8n-instance.cloud/webhook/academic-document-ingestion
N8N_CALLBACK_SECRET=your-shared-callback-secret

# Security Flags
# Authentication is controlled by NODE_ENV:
#   NODE_ENV=production  -> ONLY verified Supabase JWTs are accepted (dev tokens disabled).
#   NODE_ENV=(unset/dev) -> Supabase JWTs + registered dev tokens (registerDevToken) accepted.
# Every protected route requires a valid Bearer token; requests without one fail with HTTP 401
# and no identity is ever derived from query/body/params.
NODE_ENV=development
