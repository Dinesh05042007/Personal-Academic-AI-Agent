# ==============================================================================
# Frontend Environment Configuration Template (Personal Academic AI Agent)
# COPY THIS FILE TO .env AND FILL IN YOUR PROJECT SPECIFIC VALUES
# NEVER PUT PRIVATE SERVER SECRETS (GEMINI KEYS, SUPABASE SECRET KEYS) IN FRONTEND CODE
# ==============================================================================

# Supabase Client Authentication & Public API Access
# Supabase 2026 Standard: VITE_SUPABASE_PUBLISHABLE_KEY for browser clients
# Legacy fallback: VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key-here

# Deployed Backend Service URL (Render Web Service or cloud endpoint)
# Development: http://localhost:3000
# Production: https://your-backend.onrender.com
VITE_API_URL=http://localhost:3000
